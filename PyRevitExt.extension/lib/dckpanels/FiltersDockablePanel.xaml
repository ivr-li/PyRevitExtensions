<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="av"
      Background="White">

    <Page.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>

        <!-- Кастомный стиль TreeViewItem: растягивается и ограничивает ширину содержимого -->
        <Style x:Key="StretchingTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="Padding" Value="1,2"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <Grid x:Name="RootGrid" HorizontalAlignment="Stretch" Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="19"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Кнопка раскрытия -->
                            <Grid x:Name="Expander" Grid.Column="0" Margin="0,0,5,0" VerticalAlignment="Center">
                                <ToggleButton x:Name="ExpanderButton"
                                              IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              ClickMode="Press"
                                              Width="14" Height="14"
                                              Background="Transparent"
                                              BorderBrush="Transparent"
                                              Padding="0">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path x:Name="ExpandPath"
                                                      Data="M0,0 L0,8 L8,4 Z"
                                                      Fill="#666666"
                                                      Stretch="Uniform"
                                                      Margin="2"
                                                      RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ExpandRotate" Angle="0"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="ExpandPath" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="90"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                            </Grid>

                            <!-- Содержимое элемента -->
                            <Border x:Name="Bd"
                                    Grid.Column="1"
                                    Padding="{TemplateBinding Padding}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <!-- ОБЕРТЫВАЕМ ContentPresenter в ScrollViewer для ограничения ширины -->
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled"
                                              CanContentScroll="False"
                                              Focusable="False"
                                              ClipToBounds="False"

                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                    <ContentPresenter x:Name="PART_Header" ContentSource="Header"/>
                                </ScrollViewer>
                            </Border>

                            <!-- Дочерние элементы — под родителем -->
                            <ItemsPresenter x:Name="ItemsHost"
                                            Grid.Row="1"
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Margin="-30,2,0,0"
                                            Visibility="{Binding HasItems, Converter={StaticResource BoolToVisibilityConverter}}"/>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="false">
                                <Setter TargetName="Expander" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsExpanded" Value="false">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="true">
                                <Setter TargetName="Bd" Property="Background" Value="#E6F2FF"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#A0C4FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid Margin="2">
        <!-- Список фильтров с группировкой -->
        <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="12"
                Background="White">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Управление панелью -->
                <Grid Grid.Row="0" Margin="0,-3,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" HorizontalAlignment="Left">
                        <TextBlock Text="Фильтры вида"
                                    FontWeight="SemiBold" FontSize="11"
                                    Margin="0,0,5,0"
                                    Foreground="#666666"
                                    VerticalAlignment="Center"/>
                        <!-- Имя активного вида -->
                        <TextBlock x:Name="ViewNameTextBlock"
                                   Text="Загрузка..."
                                   FontSize="10"
                                   Foreground="#888888"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="0,0,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnAddFilters" Content="🞢"
                                Click="btn_add_filters"
                                Margin="0,0,5,0"
                                Background="#5F9EA0" Foreground="White" BorderThickness="1"
                                Padding="3,1" FontSize="14" />
                        <Button x:Name="BtnRefresh" Content="♻️"
                                Click="btn_refresh_panel"
                                Background="#5F9EA0" BorderThickness="1"
                                Padding="1,1" FontSize="14" />
                        <Separator/>
                    </StackPanel>
                </Grid>

                <!-- Заголовок и управление -->
                <Grid Grid.Row="1" Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Управление"
                               FontWeight="SemiBold" FontSize="11"
                               Foreground="#666666"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center">
                        <Button x:Name="BtnExpandAll" Content="↓"
                                Click="btn_expand_all_click" Margin="0,0,5,0"
                                Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1"
                                Padding="6,0.5" FontSize="14"/>
                        <Button x:Name="BtnCollapseAll" Content="↑"
                                Click="btn_collapse_all_click"
                                Background="Transparent" BorderBrush="#CCCCCC" BorderThickness="1"
                                Padding="6.5,0.5" FontSize="14" />
                    </StackPanel>
                </Grid>

                <!-- TreeView с кастомным поведением -->
                <TreeView x:Name="FiltersTreeView"
                        Grid.Row="2"
                        Background="White"
                        HorizontalContentAlignment="Stretch"
                        ClipToBounds="True"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource StretchingTreeViewItemStyle}"/>
                    </TreeView.ItemContainerStyle>

                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                            <Grid HorizontalAlignment="Stretch">
                                <!-- Для категорий (групп) уровня 1 -->
                                <Grid Visibility="{Binding IsCategory, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <TextBlock Text="{Binding Name}"
                                                VerticalAlignment="Center"
                                                FontWeight="SemiBold"
                                                FontSize="11"
                                                Foreground="#2D2D30"/>
                                </Grid>

                                <!-- Для фильтров уровня 2 -->
                                <Grid Visibility="{Binding IsFilter, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="10000*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Click="btn_delete_filter_click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="16" Height="16"
                                            VerticalAlignment="Center"
                                            ToolTip="Удалить фильтр из вида">
                                        <TextBlock Text="🗑️" FontSize="9"/>
                                    </Button>

                                    <Button Grid.Column="1"
                                            Click="btn_edit_filter_click"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Width="16" Height="16"
                                            VerticalAlignment="Center"
                                            ToolTip="Настройки фильтра">
                                        <TextBlock Text="⚙" FontSize="10"/>
                                    </Button>

                                    <TextBlock Grid.Column="2"
                                            Text="{Binding Name}"
                                            FontSize="11"
                                            Foreground="#2D2D30"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis"
                                            ToolTip="{Binding Name}"
                                            Margin="0,0,8,0"
                                            HorizontalAlignment="Left"/>

                                    <!-- Graphics override indicator -->
                                    <Border Grid.Column="3"
                                            Width="12" Height="12"
                                            CornerRadius="2"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Background="{Binding OverrideIndicatorColor}"
                                            BorderBrush="{Binding OverrideIndicatorBorder}"
                                            BorderThickness="{Binding OverrideIndicatorBorderThickness}"
                                            Visibility="{Binding HasGraphicsOverride, Converter={StaticResource BoolToVisibilityConverter}}"
                                            ToolTip="{Binding OverrideIndicatorTooltip}"/>

                                    <StackPanel Grid.Column="4"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center">
                                        <CheckBox IsChecked="{Binding IsFilterEnabled, Mode=TwoWay}"
                                                Margin="0,0,10,0"
                                                Checked="filter_enabled_checked"
                                                Unchecked="filter_enabled_unchecked"
                                                Focusable="False"
                                                ToolTip="Включить/выключить фильтр">
                                            <CheckBox.Content>
                                                <TextBlock Text="Вкл" FontSize="9" Foreground="#666666"/>
                                            </CheckBox.Content>
                                        </CheckBox>

                                        <CheckBox IsChecked="{Binding FilterVisibility, Mode=TwoWay}"
                                                Checked="filter_visibility_checked"
                                                Unchecked="filter_visibility_unchecked"
                                                Focusable="False"
                                                ToolTip="Видимость фильтра">
                                            <CheckBox.Content>
                                                <TextBlock Text="👁‍🗨" FontSize="9" Foreground="#666666"/>
                                            </CheckBox.Content>
                                        </CheckBox>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <Button x:Name="BtnCreateFilter" Grid.Row="3"
                        Content="Создать новый фильтр"
                        Click="btn_create_filter_click"
                        HorizontalAlignment="Stretch"
                        Margin="0,5,0,0"
                        Background="#5F9EA0" Foreground="White" BorderThickness="1"
                        Padding="0" FontSize="14" Cursor="Hand" Width="154"/>
            </Grid>
        </Border>
    </Grid>
</Page>
